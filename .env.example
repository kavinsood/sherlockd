# Environment variables for sherlockd
# Copy this file to .env and fill in your actual values

# Backend API URL - only used when the KITSUNE service binding is absent,
# e.g. when running against a local kitsune-api (go run ./cmd/kitsune-api)
KITSUNE_API_URL=http://localhost:8080/analyze

# Turnstile configuration (optional)
# Get these from Cloudflare Turnstile dashboard
WEB_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
WEB_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
